[Unit]
Description=Renew only Gmail Account Manager TLS certificate
After=network-online.target nginx.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/certbot renew --non-interactive --cert-name accounts.example.com --config-dir /etc/letsencrypt/gmail-manager --work-dir /var/lib/letsencrypt/gmail-manager --logs-dir /var/log/letsencrypt/gmail-manager --deploy-hook "/usr/sbin/nginx -t && /bin/systemctl reload nginx"
PrivateTmp=true
