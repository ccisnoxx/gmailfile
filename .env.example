# 公开示例配置：真实实例值只放入受忽略的 .env 或私有配置库，不放密码/密钥。
APP_ENV=production
APP_NAME=Gmail Account Manager
APP_BASE_URL=https://accounts.example.com
ALLOWED_HOSTS=accounts.example.com
CORS_ORIGINS=
DEBUG=false
EXPOSE_API_DOCS=false
TOTP_REQUIRED=true
# 生产必须为 true；仅本机 HTTP 开发显式设 false，使用 gm_dev_session。
SESSION_COOKIE_SECURE=true
SESSION_IDLE_MINUTES=15
SESSION_ABSOLUTE_HOURS=12
REAUTH_WINDOW_MINUTES=5
ACTIVE_DATA_KEY_VERSION=1
DEFAULT_PAGE_SIZE=30
MAX_PAGE_SIZE=100
MAX_IMPORT_SIZE_MB=10
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=gmail_manager
DATABASE_USER=gm_app
DATABASE_PASSWORD_FILE=/run/secrets/db_password
DATA_KEY_DIRECTORY=/run/secrets
# 示例绝对路径；生产父目录由 root 所有且权限为 0700。
SECRETS_DIR=/opt/example/gmail-manager/secrets
# 发布器设置 RELEASE_ID、RELEASE_DIRECTORY、DEPLOYMENT_ROOT；真实值只在私有台账记录。
# 生产示例叠加基础、production、offsite；不混入 dev/acceptance。
# production 中的示例网段/单 IP 代理信任应与私有配置及发布器检查同步定制。
# BACKUP_STATUS_FILE=/absolute/project-backups/status.json
# 不设置 BACKUP_STATUS_FILE 表示未配置（不要设为空字符串）。
# 唯一日常调度者是 operations profile 的 backup 服务，默认每天 02:00 UTC。
# 异地身份仅在源机生成；启用 offsite 前准备专用身份/主机公钥，不复用个人私钥。
# ACCEPTANCE_AT_UTC 只用于隔离验收，不改变生产长期调度。
# 配置与证据边界见 docs/public-repository.md。
